# Copy to .env (gitignored) and fill in real values before running docker-compose.
# Generate a secret: openssl rand -hex 32

# Shared JWT signing secret — every backend service that verifies tokens (workly-Common's
# JwtUtils) must use the SAME value, or cross-service auth breaks. Previously hardcoded and
# checked into git identically across 6 services — rotate it, do not reuse the old value.
AUTH_TOKEN_SECRET=
